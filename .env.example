# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# PORT: Server listening port (default: 3000)
PORT=3000

# ALLOWED_ORIGINS: Comma-separated list of allowed CORS origins for production
ALLOWED_ORIGINS="http://localhost:3000,https://astrokahawa.ug"

# Cloud SQL / PostgreSQL Database Connection (Injected by Cloud SQL / environment)
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="password"
SQL_DB_NAME="astrokahawa_db"

# Storage Configuration
# Options: 'local' (sandboxed disk) or 's3' / 'gcs' (cloud object storage)
STORAGE_PROVIDER="local"
STORAGE_BUCKET="astrokahawa-evidence-production"
STORAGE_REGION="af-south-1"
